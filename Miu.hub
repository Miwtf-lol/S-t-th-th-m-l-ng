local DARK_BG = Color3.fromRGB(30, 30, 30)
local DARK_BG_LIGHTER = Color3.fromRGB(45, 45, 45)
local ACCENT = Color3.fromRGB(200, 50, 50)
local ACCENT_HOVER = Color3.fromRGB(220, 70, 70)
